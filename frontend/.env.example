# Lab Horizon — variables d'environnement frontend
# Copier vers .env.local et adapter si besoin.
# En local, `.env.development` active déjà le mode rest vers Laravel.

# Source de données : mock | hal | rest
VITE_DATA_SOURCE=mock

# API Laravel (requis en mode rest)
# Image Docker : VITE_API_BASE_URL=same-origin (posé par le Dockerfile) — l’API est appelée
# sur l’adresse de la page, quelle qu’elle soit.
# Développement Vite (npm run dev) contre la stack Docker : Nginx HTTPS sur :8443 → backend
# VITE_DATA_SOURCE=rest
# VITE_API_BASE_URL=https://localhost:8443
#
# Laravel seul (`php artisan serve` sur :8000) :
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Exemple recherche HAL réelle (public uniquement) :
# VITE_DATA_SOURCE=hal
