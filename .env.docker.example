# Copier vers .env à la racine (lu par docker compose). Ne jamais committer .env.
# APP_KEY : peut rester vide au premier démarrage (l’entrypoint Laravel la génère).
# Pour la persister : docker compose exec backend php artisan key:generate --show

APP_KEY=

# URL publique du site (front Nginx en HTTPS). Le navigateur parle à cette origine ;
# Nginx proxy /api, /sanctum et /files vers le conteneur backend.
APP_URL=https://localhost:8443

# HTTPS sans domaine : certificat auto-signé généré au premier démarrage (alerte du
# navigateur à accepter une fois). Avec un domaine : déposer tls.crt + tls.key dans le
# volume frontend-certs, puis HSTS_MAX_AGE=31536000.
HTTP_PORT=8080
HTTPS_PORT=8443
HSTS_MAX_AGE=0
# Adresse du serveur à inclure dans le certificat, ex. IP:192.168.1.20,DNS:labhorizon.local
TLS_SAN=
# Cookies de session en HTTPS uniquement. Ne pas passer à false en production.
SESSION_SECURE_COOKIE=true

DB_DATABASE=labhorizon
DB_USERNAME=labhorizon
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

REDIS_PASSWORD=

PDF_QUEUE_NAME=pdf-processing

SANCTUM_STATEFUL_DOMAINS=localhost:8443,127.0.0.1:8443,localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173

# LLM (LM Studio) — optionnel ; profil Docker `llm` (image lourde).
# Sans LM Studio : LLM_ENABLED=false (vulgarisation IA indisponible, le reste fonctionne).
# Avec LM Studio : docker compose --profile llm up -d lm-studio
# Puis démarrer le serveur local dans le conteneur :
#   docker exec lm-studio lms server start --port 1234 --bind 0.0.0.0 --cors
LLM_ENABLED=false
LLM_URL=http://lm-studio:1234/v1
LLM_MODEL=mistral-7b-instruct-v0.3
# Durée max (s) d’une requête de génération ; le job de vulgarisation coupe à 300 s.
LLM_TIMEOUT=240

# Mot de passe du compte test@labhorizon.nc, appliqué à chaque démarrage du back.
# Obligatoire. Ne pas réutiliser le mot de passe de démo, ne pas committer .env.
APP_BOOT_PASSWORD=
