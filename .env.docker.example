# =============================================================================
# Configuration de déploiement Lab Horizon — modèle du fichier .env (racine du dépôt)
# Ne jamais committer .env. Procédure complète : docs/passation/02-lancer-et-relancer.md
#
# Le plus simple : laisser le script créer .env et générer les secrets.
#   Linux   : sh scripts/deploy/init-env.sh
#   Windows : powershell -ExecutionPolicy Bypass -File scripts\deploy\init-env.ps1
# =============================================================================

# --- 1. Secrets obligatoires ----------------------------------------------------
# Vides ici exprès : docker compose refuse de démarrer tant qu'ils ne sont pas remplis.

# Clé de chiffrement Laravel (sessions). Format base64:… sur 32 octets.
# Ne plus la changer ensuite : la changer déconnecte tous les utilisateurs.
APP_KEY=
# Base MySQL : utilisateur applicatif et administrateur root.
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Mot de passe du compte test@labhorizon.nc (compte de démonstration créé par le seed).
# Réappliqué à chaque démarrage du back : c'est le mot de passe de connexion au site.
APP_BOOT_PASSWORD=

# --- 2. Adresse du site --------------------------------------------------------
# Adresse que les visiteurs tapent dans le navigateur. Exemples :
#   https://localhost:8443          (essai sur la machine elle-même)
#   https://192.168.1.20            (serveur sur le réseau, avec HTTPS_PORT=443)
#   https://labhorizon.exemple.nc   (avec un nom de domaine)
APP_URL=https://localhost:8443
# Ports ouverts sur la machine. Sur un serveur : HTTP_PORT=80 et HTTPS_PORT=443.
HTTP_PORT=8080
HTTPS_PORT=8443
# Mêmes adresses que APP_URL, sans le https:// pour SANCTUM, avec pour CORS.
# localhost:5173 sert au développement (Vite) : à retirer sur un serveur.
SANCTUM_STATEFUL_DOMAINS=localhost:8443,127.0.0.1:8443,localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173

# --- 3. HTTPS ------------------------------------------------------------------
# Sans certificat fourni, un certificat auto-signé est généré au premier démarrage
# (alerte du navigateur à accepter une fois). Avec un domaine : déposer tls.crt + tls.key
# dans le volume labhorizon_frontend-certs, puis HSTS_MAX_AGE=31536000.
# Adresse du serveur à inclure dans le certificat, ex. IP:192.168.1.20,DNS:labhorizon.local
TLS_SAN=
HSTS_MAX_AGE=0
# Cookies de session en HTTPS uniquement. Ne pas passer à false en production.
SESSION_SECURE_COOKIE=true

# --- 4. Base de données et file d'attente ---------------------------------------
DB_DATABASE=labhorizon
DB_USERNAME=labhorizon
REDIS_PASSWORD=
PDF_QUEUE_NAME=pdf-processing

# --- 5. Vulgarisation IA (LM Studio) — optionnel ---------------------------------
# Sans LM Studio : LLM_ENABLED=false (vulgarisation IA indisponible, le reste fonctionne).
# Avec LM Studio : docker compose --profile llm up -d lm-studio (image lourde, plusieurs Go).
LLM_ENABLED=false
LLM_URL=http://lm-studio:1234/v1
LLM_MODEL=mistral-7b-instruct-v0.3
# Durée max (s) d'une requête de génération ; le job de vulgarisation coupe à 300 s.
LLM_TIMEOUT=240
