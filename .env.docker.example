# Copier vers .env à la racine (lu par docker compose). Ne jamais committer .env.
# APP_KEY : peut rester vide au premier démarrage (l’entrypoint Laravel la génère).
# Pour la persister : docker compose exec backend php artisan key:generate --show

APP_KEY=

# URL publique du site (front Nginx, port 8080). Le navigateur parle à cette origine ;
# Nginx proxy /api, /sanctum et /files vers le conteneur backend.
APP_URL=http://localhost:8080

DB_DATABASE=labhorizon
DB_USERNAME=labhorizon
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

REDIS_PASSWORD=

PDF_QUEUE_NAME=pdf-processing

SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080,localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# LLM (LM Studio) — conteneur "lm-studio" séparé (linuxserver/lm-studio), relié
# manuellement au réseau labhorizon : docker network connect <projet>_labhorizon lm-studio
# Le "Local Server" LM Studio doit écouter sur 0.0.0.0 (pas 127.0.0.1) :
#   docker exec lm-studio lms server start --port 1234 --bind 0.0.0.0 --cors
LLM_ENABLED=true
LLM_URL=http://lm-studio:1234/v1
LLM_MODEL=mistral-7b-instruct-v0.3
