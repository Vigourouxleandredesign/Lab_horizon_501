{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "pem-private-key (PKCS#8 « BEGIN PRIVATE KEY » non couvert par le preset)",
            "patterns": ["/-----BEGIN[ A-Z0-9]*PRIVATE KEY( BLOCK)?-----/"]
          },
          {
            "name": "generic-api-key-assign",
            "patterns": [
              "/(?:api[_-]?key|secret[_-]?key|access[_-]?token|client[_-]?secret)['\"]?\\s*(?:[:=]|=>)\\s*['\"][^'\"]{16,}['\"]/i"
            ]
          },
          {
            "name": "bearer-literal",
            "patterns": ["/Authorization:\\s*Bearer\\s+[A-Za-z0-9\\-._~+/]{20,}=*/"]
          }
        ]
      }
    }
  ]
}
