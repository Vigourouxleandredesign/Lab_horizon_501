# =============================================================================
# Lab Horizon — .gitignore racine (monorepo frontend + backend Laravel à venir)
# Objectif : aucun secret, aucun artefact de build, aucune config machine-local.
# =============================================================================

# --- Secrets & environnement (CRITIQUE) ---------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
*.credentials
secrets/
.secrets/

# --- Laravel / PHP (backend/ à venir) -----------------------------------------
backend/vendor/
backend/node_modules/
backend/.env
backend/.env.*
backend/storage/*.key
backend/storage/logs/
backend/storage/framework/cache/data/
backend/storage/framework/sessions/
backend/storage/framework/views/
backend/storage/app/public/
backend/storage/app/private/
backend/bootstrap/cache/*.php
backend/public/hot
backend/public/storage
backend/database/*.sqlite
backend/database/*.sqlite-journal
backend/database/*.sqlite-wal
backend/database/*.sqlite-shm
backend/phpunit.result.cache
backend/.phpunit.cache
backend/Homestead.json
backend/Homestead.yaml
backend/auth.json

# --- Node / frontend ----------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.tsbuildinfo
.vite/
frontend/.vite/

# --- Netlify ------------------------------------------------------------------
# Lien CLI local (siteId, chemins machine) — config portable : frontend/netlify.toml
.netlify/
frontend/.netlify/

# --- Logs & caches ------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
coverage/
*.lcov
.nyc_output/
.cache/
.parcel-cache/
.turbo/

# --- OS -----------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE (config personnelle) -------------------------------------------------
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json

# --- Cursor -------------------------------------------------------------------
# Les règles projet (.cursor/rules/*.mdc) sont VERSIONNÉES — charte d'équipe.
# Seule la config agent locale (MCP, transcripts) est ignorée :
.cursor/mcp.json
.cursor/**/agent-transcripts/
.cursor/**/terminals/
